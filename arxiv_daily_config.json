{
  "categories": [
    "cond-mat",
    "hep-th",
    "math-ph",
    "quant-ph"
  ],
  "only_new_submissions": true,
  "enable_summary_translation": true,
  "output_root": "arxiv_daily",
  "enable_openai_summary": true,
  "openai_model": "gpt-6.1-sol",
  "openai_max_output_tokens": 16384,
  "openai_reasoning_effort": "max",
  "openai_timeout_seconds": 300,
  "enable_fulltext_summary": true,
  "fulltext_max_chars": 240000,
  "fulltext_timeout_seconds": 45,
  "summary_workers": 4,
  "enable_deepseek_summary": true,
  "deepseek_model": "deepseek-reasoner",
  "deepseek_max_tokens": 8192,
  "deepseek_timeout_seconds": 180
}
